{
  "manifest_version": 3,
  "name": "Three Slicer — 3D printing slicer",
  "short_name": "Three Slicer",
  "version": "0.0.0",
  "description": "Open STL, 3MF, OBJ, STEP and G-code files in a full 3D printing slicer that runs in the browser. Nothing is uploaded.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "Open Three Slicer"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.thingiverse.com/*"
      ],
      "js": [
        "content_thingiverse.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "downloads",
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "cross_origin_embedder_policy": {
    "value": "require-corp"
  },
  "cross_origin_opener_policy": {
    "value": "same-origin"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
