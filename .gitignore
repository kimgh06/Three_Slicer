# ── Global (any path) ─────────────────────────────────────
*.o
*.log
*_dbg.wasm

*.mo
*.pyc
__pycache__/
**/.DS_Store
**/CMakeLists.txt.autosave
CMakeLists.txt.user
.idea/
/.vscode/
.vs/*
.clangd
/.cache/
*.code-workspace
.init_bundle.ini
node_modules/

# Tool directories (sessions/plugins)
.omc/
.omo/
.fablize*/
.claude/
.playwright-mcp/
.env/

# ── web/ (the demo app) + packages/ (the npm workspaces) ──
web/**/dist/
examples/**/dist/
web/viewer/public/demos/
web/**/*.gcode
web/**/*.tsbuildinfo
packages/**/dist/
packages/**/*.gcode
packages/**/*.tsbuildinfo

# ── Kernel development byproducts (not kept in the repository) ──
# Per-stage verification screenshots: evidence only cited by path in the docs, with no reason to live in a source repo (6.6MB).
packages/wasm-core/*.png
packages/wasm-core/screenshots/
# Emscripten test outputs: build artifacts regenerable with build.sh (6.5MB).
#  The shipped kernel (packages/engine/src/slicer_core*.js) stays tracked as an exception.
packages/wasm-core/**/test_*.wasm
packages/wasm-core/**/test_*.js
# One-off investigation/reproduction scripts (not part of the regression suite)
packages/wasm-core/repro_*.mjs
packages/wasm-core/compare_*.mjs

# The upstream clone kept for reference (a separate repository)
slicer/
# ...and the multi-slicer reference checkout beside it (OrcaSlicer + PrusaSlicer clones, 2.3GB, each its own repo)
slicers/
blogs/
viewer-package/**/dist/
